{
  "info": {
    "_postman_id": "b3f0a4d0-7a1e-4e2b-9c3a-verity0api0v1",
    "name": "Verity API v1",
    "description": "REST API for Verity, a self-hosted, auditable forum.\n\nBase URL: {{baseUrl}} (http://localhost:5080/api/v1 by default - see the \"Verity (local)\" environment).\n\nAuth: username/password issues a JWT bearer token from POST /auth/register or POST /auth/login. Send it as `Authorization: Bearer <token>`. This collection stores tokens automatically into the `token` (regular user, jateen) and `moderatorToken` (moderator, mod_alice) environment variables as the Auth folder runs.\n\nErrors: every failure is an RFC 9457 application/problem+json body with type/title/status/detail/traceId (validation failures also carry an `errors` map).\n\nSeed accounts: set the seedPassword environment variable to match SEED_PASSWORD (see .env.example in the repo). Usernames are listed in the repo's DbSeeder.cs - two moderators and five regular users, one of whom has zero posts.\n\nRun the folders in order (00-05) for a full pass; run 06 separately with the Collection Runner (11 iterations) to see the auth rate limit trip.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5080/api/v1"
    },
    {
      "key": "serverUrl",
      "value": "http://localhost:5080"
    }
  ],
  "item": [
    {
      "name": "00 Health",
      "item": [
        {
          "name": "Get health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{serverUrl}}/health",
              "host": [
                "{{serverUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('status is healthy', () => pm.expect(pm.response.json().status).to.eql('healthy'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Registers a fresh random user so this collection can be re-run without colliding with a previous run.",
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{randomUsername}}\",\n  \"email\": \"{{randomUsername}}@example.test\",\n  \"password\": \"{{seedPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('randomUsername', 'pmuser_' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('has accessToken', () => pm.expect(pm.response.json().accessToken).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as jateen",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "jateen is a seeded regular user. Stores the token used by later requests as the regular-user identity.",
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"jateen\",\n  \"password\": \"{{seedPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('token', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
