# Optional overrides for `docker compose up`. Every value below already has a
# working default baked into docker-compose.yml, so copying this file is only
# necessary if you want to change one of them. These are local development
# defaults for a throwaway database - not real secrets.

# Password given to every seeded demo account (see README "Seed accounts").
# Must satisfy the password policy: 8-128 characters, at least one letter and
# one digit.
SEED_PASSWORD=demo-only-password-1

# Postgres credentials. These are only read when the database volume is first
# created; changing them later requires `docker compose down -v`.
POSTGRES_DB=verity
POSTGRES_USER=verity
POSTGRES_PASSWORD=verity_dev_password
